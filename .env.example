# ======================================
# OPTIONAL: GitHub Configuration
# ======================================
# GitHub Releases Token (optional - for download feature)
# Create a token with read-only access to public releases
# Only needed if you want the download button to work
GITHUB_RELEASES_READONLY_TOKEN=your_readonly_releases_token


# ======================================
# OPTIONAL: AWS/S3 Configuration
# ======================================
# Required for newsletter subscriptions and demo requests
AWS_REGION=us-east-1

# S3 bucket for email list (newsletter subscriptions) and demo requests
EMAIL_LIST_S3_BUCKET=your-email-list-bucket

# ======================================
# OPTIONAL: Server Configuration
# ======================================
# Environment (development, production, test)
NODE_ENV=development

# Server hostname (defaults to localhost)
# HOSTNAME=localhost

# Server port (defaults to 3002)
# PORT=3002

# ======================================
# NOTES
# ======================================
# AWS/S3 variables are required if you want to:
# - Collect email subscriptions (requires EMAIL_LIST_S3_BUCKET)
# - Store demo requests (requires EMAIL_LIST_S3_BUCKET)
#
# Authentication is handled by the auth-server service

# ======================================
# OPTIONAL: Google Analytics Configuration
# ======================================
# Google Analytics 4 Measurement ID for tracking page views and events
# Get from: https://analytics.google.com/
# Format: G-XXXXXXXXXX
# Note: Must start with NEXT_PUBLIC_ to be available in the browser
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
